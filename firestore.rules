rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A rule on /users/{userId} does NOT cover /users/{userId}/cards/{id}.
    // Firestore rules never cascade into subcollections, so the nested match
    // below is what makes cards, notes, days, drill and extra readable.
    match /users/{userId} {
      allow read, write: if true;

      match /{sub}/{docId} {
        allow read, write: if true;
      }
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }
  }
}
